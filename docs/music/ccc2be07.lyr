{"w":[[17.314,20.904,"夜色里我独自走",1],[21.064,24.973,"回忆像潮水不停流",1],[25.133,27.846,"你曾经的温柔",1],[28.005,29.96,"如今只是沉默",1],[30.08,31.316,"心在呼喊",0],[31.436,32.952,"你却听不见",1],[33.032,33.431,"眼泪落下",0],[33.59,34.548,"没有人看见",1],[34.707,36.303,"我在黑暗里寻找",1],[36.463,38.737,"却找不到你的回答",1],[38.777,40.612,"曾经说过要一起走",1],[40.771,42.447,"风雨里不放开手",1],[42.606,43.444,"但你远去了",1],[43.564,46.064,"留下我独自承受",1],[46.09,46.596,"心在呼喊",0],[46.755,47.793,"你却听不见",1],[47.952,48.75,"眼泪落下",0],[48.91,49.867,"没有人看见",1],[50.027,51.622,"我在黑暗里寻找",1],[51.782,54.375,"却找不到你的回答",1],[54.495,58.085,"如果时间能够倒流",1],[58.245,60.479,"我愿停在你微笑的那一刻",1],[60.559,65.745,"可惜梦醒之后",1],[65.824,69.535,"只剩下寂寞",1],[69.654,71.33,"夜越来越冷",1],[71.489,73.484,"心越来越空",1],[73.644,75.08,"你的沉默",1],[75.239,76.596,"比告别更痛",1]]}