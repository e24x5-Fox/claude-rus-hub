{"w":[[1.197,3.989,"夜色里我独自走",1],[4.149,8.378,"回忆像潮水不停流",1],[8.537,12.527,"你曾经的温柔",1],[12.686,16.636,"如今只是沉默",1],[16.755,18.112,"心在呼喊",0],[18.271,20.665,"你却听不见",1],[20.824,22.181,"眼泪落下",0],[22.3,24.255,"没有人看见",1],[24.415,28.085,"我在黑暗里寻找",1],[28.245,29.745,"却找不到你的回答",1],[49.069,51.543,"曾经说过要一起走",1],[51.622,57.048,"风雨里不放开手",1],[57.207,60.638,"但你远去了",1],[60.798,65.865,"留下我独自承受",1],[65.984,67.261,"心在呼喊",0],[67.42,69.814,"你却听不见",1],[69.973,71.41,"眼泪落下",0],[71.529,73.404,"没有人看见",1],[73.564,77.234,"我在黑暗里寻找",1],[77.394,79.734,"却找不到你的回答",1],[79.841,85.213,"如果时间能够倒流",1],[85.372,89.282,"我愿停在你微笑的那一刻",1],[89.441,93.989,"可惜梦醒之后",1],[94.149,100.731,"只剩下寂寞",1],[100.851,105.16,"夜越来越冷",1],[105.319,109.707,"心越来越空",1],[109.827,110.824,"你的沉默",1],[110.984,114.734,"比告别更痛",1]]}