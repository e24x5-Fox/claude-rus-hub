{"w":[[17.08,19.22,"夜色里我独自走",1],[19.78,22.98,"回忆像潮水不停流",1],[23.58,26.42,"你曾经的温柔",1],[27.16,29.16,"如今只是沉默",1],[30.72,33.2,"心在呼喊",0],[33.2,34.54,"你却听不见",1],[35.8,36.92,"眼泪落下",0],[36.92,38.3,"没有人看见",1],[39.08,41.1,"我在黑暗里寻找",1],[41.3,43.46,"却找不到你的回答",1],[44.52,48.2,"曾经说过要一起走",1],[48.6,50.1,"风雨里不放开手",1],[50.42,51.78,"但你远去了",1],[52.08,53.94,"留下我独自承受",1],[54.4,56.06,"心在呼喊",0],[56.06,57.32,"你却听不见",1],[58.14,59.76,"眼泪落下",0],[59.76,61.08,"没有人看见",1],[62.38,63.98,"我在黑暗里寻找",1],[64.16,66.28,"却找不到你的回答",1],[67.38,72.56,"如果时间能够倒流",1],[72.88,76.3,"我愿停在你微笑的那一刻",1],[76.78,78.8,"可惜梦醒之后",1],[78.94,80.58,"只剩下寂寞",1],[80.88,88.1,"夜越来越冷",1],[88.58,91.72,"心越来越空",1],[92.4,93.16,"你的沉默",1],[93.42,95.6,"比告别更痛",1]]}