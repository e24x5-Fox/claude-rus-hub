{"w":[[17.394,20.904,"夜色里我独自走",1],[21.064,24.734,"回忆像潮水不停流",1],[24.894,27.606,"你曾经的温柔",1],[27.766,32.434,"如今只是沉默",1],[32.553,33.271,"心在呼喊",0],[33.431,36.144,"你却听不见",1],[36.303,37.101,"眼泪落下",0],[37.261,38.218,"没有人看见",1],[38.298,40.612,"我在黑暗里寻找",1],[40.771,46.316,"却找不到你的回答",1],[46.436,48.59,"曾经说过要一起走",1],[48.75,50.745,"风雨里不放开手",1],[50.904,52.34,"但你远去了",1],[52.5,55.333,"留下我独自承受",1],[55.452,56.17,"心在呼喊",0],[56.33,58.963,"你却听不见",1],[59.122,59.92,"眼泪落下",0],[60.08,62.314,"没有人看见",1],[62.473,64.229,"我在黑暗里寻找",1],[64.388,66.409,"却找不到你的回答",1],[66.516,73.803,"如果时间能够倒流",1],[73.963,77.633,"我愿停在你微笑的那一刻",1],[77.793,79.069,"可惜梦醒之后",1],[79.229,86.05,"只剩下寂寞",1],[86.17,90.399,"夜越来越冷",1],[90.559,92.314,"心越来越空",1],[92.433,94.947,"你的沉默",1],[95.027,95.904,"比告别更痛",1]]}