{"w":[[16.436,19.628,"夜色里我独自走",1],[19.787,23.537,"回忆像潮水不停流",1],[23.697,27.207,"你曾经的温柔",1],[27.367,30.997,"如今只是沉默",1],[31.117,31.835,"心在呼喊",0],[31.995,34.628,"你却听不见",1],[34.787,35.505,"眼泪落下",0],[35.625,38.298,"没有人看见",1],[38.457,41.729,"我在黑暗里寻找",1],[41.888,45.837,"却找不到你的回答",1],[45.957,47.394,"曾经说过要一起走",1],[47.553,49.468,"风雨里不放开手",1],[49.628,51.223,"但你远去了",1],[51.383,52.883,"留下我独自承受",1],[60.718,61.356,"心在呼喊",0],[61.516,64.149,"你却听不见",1],[64.309,65.027,"眼泪落下",0],[65.147,67.819,"没有人看见",1],[67.979,71.33,"我在黑暗里寻找",1],[71.489,78.138,"却找不到你的回答",1],[78.245,79.867,"如果时间能够倒流",1],[80.027,85.372,"我愿停在你微笑的那一刻",1],[85.532,87.686,"可惜梦醒之后",1],[87.846,88.883,"只剩下寂寞",1]]}